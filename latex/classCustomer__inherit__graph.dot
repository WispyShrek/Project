  Node1 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node2 [label="EasyCust",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classEasyCust.html",tooltip="Represents an easygoing customer with predefined preferences and a payment strategy...."];
  Node1 -> Node3 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node3 [label="FussyCust",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classFussyCust.html",tooltip="Represents a fussy customer with specific preferences and a payment strategy. Inherits from the abstr..."];
}
