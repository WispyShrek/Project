digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  rankdir="LR";
  Node0 [label="PaymentStrategy",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classPaymentStrategy.html",tooltip="An abstract base class for different payment strategies."];
  Node0 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node1 [label="Card",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classCard.html",tooltip="A concrete payment strategy for card payments."];
  Node0 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="Cash",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classCash.html",tooltip="A concrete payment strategy for cash payments."];
  Node0 -> Node3 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node3 [label="EFT",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classEFT.html",tooltip="A concrete payment strategy for Electronic Funds Transfer (EFT)."];
}
