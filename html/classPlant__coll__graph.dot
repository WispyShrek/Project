digraph "Plant"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="Plant",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="An abstract base class representing a plant in the nursery."];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" strategy" ,fontname="Helvetica"];
  Node2 [label="CareStrategy",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classCareStrategy.html",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" customer" ,fontname="Helvetica"];
  Node3 [label="Customer",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classCustomer.html",tooltip="Represents a customer interacting with the sales floor and managing a cart of plants...."];
  Node4 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" currState" ,fontname="Helvetica"];
  Node4 [label="PlantState",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classPlantState.html",tooltip="An abstract base class representing the state of a plant."];
}
