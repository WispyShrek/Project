digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  rankdir="LR";
  Node0 [label="Customer",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classCustomer.html",tooltip="Represents a customer interacting with the sales floor and managing a cart of plants...."];
  Node0 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node1 [label="EasyCust",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classEasyCust.html",tooltip="Represents an easygoing customer with predefined preferences and a payment strategy...."];
  Node0 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="FussyCust",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classFussyCust.html",tooltip="Represents a fussy customer with specific preferences and a payment strategy. Inherits from the abstr..."];
}
